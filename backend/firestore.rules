rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Section 7.1 Infrastructure Contract:
    // Clients NEVER write to Firestore directly — all writes go through Cloud Functions API.
    // Read access only for items that benefit from client-side realtime subscriptions.
    
    match /alerts/{id} {
      allow read: if resource.data.status == 'active';
      allow write: if false;
    }

    match /notifications/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Default deny all client reads and writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
