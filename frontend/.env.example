# ==============================================================================
# UCL Campus Hub — Frontend Environment Variables (.env.example)
# Copy this file to `frontend/.env` and supply your project values.
# Note: Variables prefixed with EXPO_PUBLIC_ are embedded into the client bundle.
# ==============================================================================

# Backend REST API Base URL (§1.1 in docs/API-Contract+DataModel.md)
# Local Firebase Emulator:
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5001/campus-management-system/asia-south1/api/v1
# Production Cloud Functions:
# EXPO_PUBLIC_API_BASE_URL=https://asia-south1-campus-management-system.cloudfunctions.net/api/v1

# Firebase Client Configuration (Firebase Console > Project Settings > General)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDemoKeyReplaceWithYourOwn
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=campus-management-system.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=campus-management-system
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=campus-management-system.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
